# Required secrets
GEMINI_API_KEY=your_gemini_api_key_here
API_KEY=your_application_api_key_here

# Storage
DATABASE_URL=sqlite+aiosqlite:///./wealthie.db
UPLOAD_DIR=./uploads
MAX_IMAGE_SIZE_MB=10

# Worker controls
MAX_CONCURRENT_JOBS=5

# HTTP / observability
ALLOWED_ORIGINS=http://localhost:8000
LOG_LEVEL=INFO
